# Plantilla de variables de entorno del proyecto.
# Copia este archivo a .env.local (ignorado por git) y completa los valores reales ahí.
# Nunca escribas claves, tokens o contraseñas reales en el código fuente ni en este archivo.
#
# Las variables expuestas al navegador deben empezar con VITE_ (así las lee import.meta.env.*)
# y NUNCA deben contener secretos: cualquier VITE_* queda visible en el bundle final.
# Cualquier API key real (de un backend, panel de administrador, etc.) vive del lado del
# servidor, fuera de este proyecto de frontend.

# Ejemplo (sin valor real):
# VITE_API_BASE_URL=https://api.ejemplo.com

# URL de la API de disponibilidad (Google Apps Script publicado como web app,
# lee la hoja "BoraBora - Disponibilidad"). De solo lectura, sin autenticación.
VITE_DISPONIBILIDAD_API_URL=
